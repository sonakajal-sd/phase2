generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  AGENT
  CUSTOMER
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
}

model Ticket {
  id              Int    @id @default(autoincrement())
  title           String
  description     String
  customerId      Int
  assignedAgentId Int?

  createdAt DateTime @default(now())
}
