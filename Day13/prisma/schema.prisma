generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Ticket {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  priority    String
  status      String   @default("open")
  assignee    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}